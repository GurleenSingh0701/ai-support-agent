# --- Google Gemini AI API Configuration ---
# Your Google Gemini API Key for Intent Classification, Sentiment Analysis & Sub-Agents
GOOGLE_API_KEY=AIzaSy_YOUR_PRODUCTION_GOOGLE_GEMINI_API_KEY
GEMINI_API_KEY=AIzaSy_YOUR_PRODUCTION_GOOGLE_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.1-flash-lite

# --- JWT Authentication & Security ---
# Secret key used for signing JWT access and refresh tokens.
# Generate a new 256-bit secret using: openssl rand -hex 32
SECRET_KEY=e839f28a9b2c417d6e5a019483726510bf3c2948d02e4857106c9a871295b364
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database Credentials & Connections ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ReplaceWithStrongProductionPassword123!
POSTGRES_DB=autodesk_db
DATABASE_URL=postgresql+psycopg://postgres:ReplaceWithStrongProductionPassword123!@db:5432/autodesk_db

# --- Redis Caching & Escalation Pub/Sub ---
REDIS_URL=redis://redis:6379/0

# --- Frontend API Connectivity ---
# In Docker Compose, point to the internal backend container (http://backend:8000).
# On cloud platforms (Railway/Render), point to your backend's public HTTPS URL.
API_BASE_URL=http://backend:8000
BACKEND_URL=http://backend:8000
